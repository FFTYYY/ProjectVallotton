# Vallotton 的配置。复制成 .env 再填；.env 不进 git。
# 这里只列需要你填或者常改的项，其余都有默认值，见部署教程的「环境变量一览」。

# ============== 大模型 ==============
# 用哪家：deepseek 或 grok。只读选中那家的密钥。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 想换模型时改这里
DEEPSEEK_MODEL=deepseek-flash
GROK_MODEL=grok-4.6
# 备用线路：填了以后官方接口连不上时自动改走 OpenRouter，留空只有官方一条线路
OPENROUTER_API_KEY=

# ============== 画图 ==============
NOVELAI_API_KEY=pst-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============== 账号 ==============
# 网页登录
APP_USERNAME=user
APP_PASSWORD=change-me
# 管理后台的密码，平时用不到，填一串随机字符
ADMIN_PASSWORD=change-me-too

# ============== 网站 ==============
# 一串随机字符。生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me
# 你的域名，不带 https://。只有通过它访问才能登录。
DOMAIN=vallotton.example.com

# ============== 数据库和图片 ==============
# 数据库的密码，填一串随机字符
POSTGRES_PASSWORD=change-me
# 服务器上存图片的目录，用绝对路径；部署教程里建的就是这个
MEDIA_DIR=/srv/vallotton/media

# ============== 端口和 MCP ==============
# Vallotton 在服务器本机的端口，和别的程序冲突时改；MCP 的端口同理
VALLOTTON_HTTP_PORT=8300
MCP_PUBLIC_PORT=8301
# 启用 MCP 时必填：访问 MCP 要带的密钥。生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=change-me
# 0.0.0.0 表示外面可以直接访问 MCP；默认只有服务器本机能访问
MCP_BIND=127.0.0.1
